{
  "manifest_version": 3,
  "name": "RRM Research Library Lookup",
  "version": "0.1.0",
  "description": "Shows the RRM Research Library's synopsis, grade and citation for the paper you're reading.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "contextMenus",
    "storage"
  ],
  "host_permissions": [
    "https://pubmed.ncbi.nlm.nih.gov/*",
    "https://pmc.ncbi.nlm.nih.gov/*",
    "https://www.ncbi.nlm.nih.gov/*",
    "https://doi.org/*",
    "https://dx.doi.org/*",
    "https://europepmc.org/*",
    "https://www.sciencedirect.com/*",
    "https://link.springer.com/*",
    "https://www.nature.com/*",
    "https://onlinelibrary.wiley.com/*",
    "https://obgyn.onlinelibrary.wiley.com/*",
    "https://academic.oup.com/*",
    "https://www.tandfonline.com/*",
    "https://journals.sagepub.com/*",
    "https://www.cambridge.org/*",
    "https://jamanetwork.com/*",
    "https://www.nejm.org/*",
    "https://www.bmj.com/*",
    "https://www.frontiersin.org/*",
    "https://www.mdpi.com/*",
    "https://journals.plos.org/*",
    "https://www.fertstert.org/*",
    "https://evidence.nejm.org/*",
    "https://bjsm.bmj.com/*",
    "https://rrmacademy.org/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "RRM Research Library Lookup",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "src/icons/icon-16.png",
      "32": "src/icons/icon-32.png",
      "48": "src/icons/icon-48.png",
      "128": "src/icons/icon-128.png"
    }
  },
  "icons": {
    "16": "src/icons/icon-16.png",
    "32": "src/icons/icon-32.png",
    "48": "src/icons/icon-48.png",
    "128": "src/icons/icon-128.png"
  },
  "side_panel": {
    "default_path": "src/sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://pubmed.ncbi.nlm.nih.gov/*",
        "https://pmc.ncbi.nlm.nih.gov/*",
        "https://www.ncbi.nlm.nih.gov/*",
        "https://doi.org/*",
        "https://dx.doi.org/*",
        "https://europepmc.org/*",
        "https://www.sciencedirect.com/*",
        "https://link.springer.com/*",
        "https://www.nature.com/*",
        "https://onlinelibrary.wiley.com/*",
        "https://obgyn.onlinelibrary.wiley.com/*",
        "https://academic.oup.com/*",
        "https://www.tandfonline.com/*",
        "https://journals.sagepub.com/*",
        "https://www.cambridge.org/*",
        "https://jamanetwork.com/*",
        "https://www.nejm.org/*",
        "https://www.bmj.com/*",
        "https://www.frontiersin.org/*",
        "https://www.mdpi.com/*",
        "https://journals.plos.org/*",
        "https://www.fertstert.org/*",
        "https://evidence.nejm.org/*",
        "https://bjsm.bmj.com/*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
